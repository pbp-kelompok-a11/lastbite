# LastBite — Environment Variables
# Copy this file to .env and fill in the values
# DO NOT commit .env to git!

# Django secret key (generate a new one for production!)
SECRET_KEY=your-secret-key-here

# Set to False in production
DEBUG=True

# Space-separated list of allowed hosts
# Example: ALLOWED_HOSTS=localhost 127.0.0.1 lastbite.pbp.cs.ui.ac.id
ALLOWED_HOSTS=localhost 127.0.0.1

# Space-separated CSRF trusted origins
# Example: CSRF_TRUSTED_ORIGINS=https://lastbite.pbp.cs.ui.ac.id
CSRF_TRUSTED_ORIGINS=http://localhost http://127.0.0.1
